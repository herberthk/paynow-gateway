model User {
  id                Int             @id(map: "idx_31735_primary") @default(autoincrement())
  name              String?         @db.VarChar(255)
  email             String?         @unique(map: "idx_31735_users_email_unique") @db.VarChar(255)
  tel               String?         @unique(map: "idx_31735_tel") @db.VarChar(255)
  password          String?         @db.VarChar(255)
  profile           String?         @db.VarChar(255)
  status            Boolean         @default(true)
  address           String?
  ispaid            Boolean         @default(false)
  email_verified_at DateTime?       @db.Timestamptz(6)
  push_token        String?         @db.VarChar(255)
  push_token_error  String?
  app_version       String?         @db.VarChar(255)
  os                String?         @db.VarChar(255)
  device            String?         @db.VarChar(255)
  remember_token    String?         @db.VarChar(100)
  otp               String?         @db.VarChar(255)
  otp_expiry        DateTime?       @db.Timestamptz(6)
  apple_user        String?         @unique(map: "idx_31735_apple_user") @db.VarChar(100)
  created_at        DateTime?       @db.Timestamptz(6)
  updated_at        DateTime?       @db.Timestamptz(6)
  deleted_at        DateTime?       @db.Timestamptz(6)
  privilege         user_privilege? @default(none)
  is_ghost_user     Boolean         @default(false)
  wallet           Wallet?
  paymentMethods   PaymentMethod[]
  disputes         Dispute[]
  auditLogs        AuditLog[]
  // systemNotifications SystemNotification[]
  paymentOtp             Otp?
 sentTransactions     Transaction[] @relation("TransactionSender")
 receivedTransactions Transaction[] @relation("TransactionRecipient")
  @@index([privilege], map: "idx_user_preveledge")
  @@index([id, name, profile], map: "idx_users_covering")
  @@index([id], map: "idx_users_id")
  @@index([name], map: "idx_users_name")
  @@index([created_at])
  @@index([name(ops: raw("gin_trgm_ops"))], map: "users_name_trgm_idx", type: Gin)
  @@index([os, status])
  @@index([status])
  @@map("users")
}

enum user_privilege {
  none
  admin
  super_admin
}

model Otp{
  id String @id @default(uuid())
  userId Int @unique
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  otpHash String
  expiresAt  DateTime
  createdAt DateTime @default(now())
  attempts Int @default(0)
  @@index([expiresAt])
  @@map("Payment_otp")
}

model Wallet {
  id        String   @id @default(uuid())
  userId    Int   @unique
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  balance Decimal  @default(0) @db.Decimal(12, 2)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  @@index([createdAt])
  @@map("payment_wallets")
}

model PaymentMethod {
  id        String @id @default(uuid())
  userId    Int
  user      User @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      PaymentMethodType
  name      String
  detail    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId,createdAt])
  @@map("payment_methods")
}


model Transaction {
  id        String  @id @default(uuid())

  userId    Int
  sender    User    @relation("TransactionSender", fields: [userId], references: [id], onDelete: Cascade)

  recipientId Int
  recipient   User   @relation("TransactionRecipient", fields: [recipientId], references: [id], onDelete: Cascade)

  recipientName String
  amount    Decimal           @db.Decimal(12, 2)
  currency  Currency          @default(UGX)
  type      TransactionType
  status    TransactionStatus @default(PENDING)
  txn_ref   String            @unique
  category  String
  method    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deleted_at DateTime?
  disputes  Dispute[]

  @@index([recipientId])
  @@index([recipientName])
  @@index([status])
  @@index([type])
  @@index([method])
  @@index([category])
  @@index([txn_ref])
  @@index([userId, createdAt])
  @@map("payment_transactions")
}


model Dispute {
  id            String        @id @default(uuid())
  transactionId String @unique
  transaction   Transaction   @relation(fields: [transactionId], references: [id])
  userId        Int
  user          User          @relation(fields: [userId], references: [id])
  amount        Decimal       @db.Decimal(12, 2)
  currency      Currency        @default(UGX)
  reason        String
  status        DisputeStatus @default(OPEN)
  evidence      String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  deleted_at DateTime?
  @@index([userId])
  @@index([createdAt,status])
  @@map("payment_disputes")
}

model Fee {
  id          String      @id @default(uuid())
  name        String
  type        FeeType
  value       Decimal     @db.Decimal(12, 2)
  currency    Currency    @default(UGX)
  category    FeeCategory
  active      Boolean     @default(true)
  lastUpdated DateTime    @updatedAt
  createdAt   DateTime    @default(now())
  deleted_at DateTime?
  @@map("payment_fees")
}

model AuditLog {
  id        String   @id @default(uuid())
  action    String
  adminId   Int
  admin     User     @relation(fields: [adminId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  details   String
  ip        String?
  path      String?
  @@index([adminId])
  @@index([createdAt])
  deleted_at DateTime?
  @@map("payment_audit_logs")
}

model SystemNotification {
  id        String   @id @default(uuid())
  fromUserId    Int //Sender userId
  toUserId    Int // Recipient userId
  title     String
  message   String
  path      String // Path to redirect to
  type      NotificationType @default(INFO)
  read      Boolean          @default(false)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  @@index([fromUserId,type,toUserId])
  @@index([createdAt])
  @@map("payment_system_notifications")
}

enum PaymentProvider {
  AIRTEL
  MTN
}

enum PaymentMethodType {
  CARD
  MOBILE_MONEY
  BANK
}

enum DisputeStatus {
  OPEN
  RESOLVED
  REJECTED
}

enum FeeType {
  PERCENTAGE
  FIXED
}

enum FeeCategory {
  DEPOSIT
  WITHDRAWAL
  TRANSFER
  PAYMENT
  API
}

enum NotificationType {
  ALERT
  INFO
  SUCCESS
}

enum TransactionType {
  DEPOSIT
  WITHDRAWAL
  TRANSFER
  PAYMENT
  SUBSCRIPTION
}

enum TransactionStatus {
  COMPLETED
  PENDING
  FAILED
  DISPUTED
}

enum Currency {
  UGX
  USD
}
  