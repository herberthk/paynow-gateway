model Transaction {
  id        String  @id @default(uuid())

  userId    Int
  sender    User    @relation("TransactionSender", fields: [userId], references: [id], onDelete: Cascade)

  recipientId Int
  recipient   User   @relation("TransactionRecipient", fields: [recipientId], references: [id], onDelete: Cascade)

  displayName String?
  amount    Decimal           @db.Decimal(12, 2)
  currency  Currency          @default(UGX)
  type      TransactionType
  status    TransactionStatus @default(PENDING)
  txn_ref   String            @unique
  category  String
  method    String
  reason     String?
  receiptUrl String?
  fee       Decimal           @db.Decimal(12, 2) @default(0.00)
  // Yo! Payments correlation fields (also usable by future providers).
  // externalReference = our idempotency key sent via setExternalReference().
  // For Yo top-ups it equals txn_ref. Webhooks echo it back as
  // success.external_ref / failure.failed_transaction_reference.
  externalReference String? @unique
  // Gateway-side reference returned by acDepositFunds (polling/support).
  providerRef String?
  // Payer MSISDN in 256XXXXXXXXX format + detected network.
  msisdn   String?
  provider MobileMoneyProvider?
  // Gateway network_ref from success IPN.
  networkRef String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deleted_at DateTime?
  disputes  Dispute[]
  ledger    Ledger[]

  @@index([recipientId])
  @@index([status])
  @@index([type])
  @@index([method])
  @@index([category])
  @@index([providerRef])
  @@index([msisdn])
  @@index([status, createdAt])
  @@index([type, status, createdAt])
  @@index([userId, type, status, createdAt])
  @@index([userId])
  @@index([createdAt])
  @@map("payment_transactions")
}

enum TransactionType {
  DEPOSIT
  WITHDRAWAL
  TRANSFER
  PAYMENT
  SUBSCRIPTION
  SUPPORT
}

enum TransactionStatus {
  COMPLETED
  PENDING
  FAILED
  INDETERMINATE
}
