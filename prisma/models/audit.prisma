model AuditLog {
  id        String   @id @default(uuid())
  action    String
  adminId   Int
  admin     User     @relation(fields: [adminId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  details   String
  ip        String?
  path      String?
  @@index([adminId])
  @@index([createdAt])
  deleted_at DateTime?
  @@map("payment_audit_logs")
}