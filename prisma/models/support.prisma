model SupportUser {
    id String @id @default(cuid())
    fromUserId Int
    toUserId   Int
    reference String
    amount Decimal  @default(0) @db.Decimal(12, 2)
    currency Currency @default(UGX)
    paymentMethod PaymentMethodType @default(MOBILE_MONEY)
    reason String?
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
    @@index([fromUserId])
    @@index([toUserId])
    @@index([reference])
    @@index([createdAt])
    @@map("support_users")
}