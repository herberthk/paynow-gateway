model Fee {
  id          String      @id @default(uuid())
  name        String
  type        FeeType
  value       Decimal     @db.Decimal(12, 4)
  currency    Currency    @default(UGX)
  category    FeeCategory @unique @default(TRANSFER)
  active      Boolean     @default(true)
  lastUpdated DateTime    @updatedAt
  createdAt   DateTime    @default(now())
  deleted_at DateTime?
  @@index([category,active])
  @@map("payment_fees")
}

enum FeeType {
  PERCENTAGE
  FIXED
}

enum FeeCategory {
  DEPOSIT
  WITHDRAWAL
  TRANSFER
  PAYMENT
  SUPPORT
}