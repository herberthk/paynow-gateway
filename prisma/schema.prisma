  type              String    @db.VarChar(15)
  created_at        DateTime? @db.Timestamptz(6)
  updated_at        DateTime? @db.Timestamptz(6)
}

model account_ledgers {
  id          BigInt      @id(map: "account_ledger_pkey") @default(autoincrement())
